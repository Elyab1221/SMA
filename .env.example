# ==========================================================
# Cyber Talent Club SMA - Environment Variables Template
# Copy this file to .env for local configuration
# ==========================================================

# PostgreSQL connection URL:
# Format: postgresql://username:password@hostname:port/database_name
# Note: Special characters in passwords (like '@') must be URL-encoded (e.g., %40)
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/club_sma

# Local web port
PORT=5050

# Application secret key for secure cookie signing (generate a random 32-byte string)
SECRET_KEY=generate_a_random_32_byte_hex_string_here

# Set to 1 when running behind HTTPS or in production
HTTPS=0
FLASK_DEBUG=0
